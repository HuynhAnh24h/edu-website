# Copy file này thành .env trên server production và ĐỔI TOÀN BỘ MẬT KHẨU trước khi chạy!
HTTP_PORT=80

# PostgreSQL 16 + pgvector
POSTGRES_USER=edu_admin
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD_32_CHARS
POSTGRES_DB=edu_k12

# JWT Secret (>= 64 ký tự ngẫu nhiên, VD: openssl rand -hex 32)
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX_SECRET

# AI Tutor Provider: auto | ollama | mock
AI_PROVIDER=auto
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b
